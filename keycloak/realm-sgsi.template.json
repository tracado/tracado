{
  "realm": "sgsi",
  "enabled": true,
  "displayName": "Traçado",
  "displayNameHtml": "<div class=\"grc-brand\">Traçado<span>GOVERNANÇA · RISCO · COMPLIANCE</span></div>",
  "loginTheme": "tracado",
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "clients": [{
    "clientId": "sgsi-gateway",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "secret": "${KEYCLOAK_CLIENT_SECRET}",
    "redirectUris": ["${PORTAL_PUBLIC_URL}/oauth2/callback"],
    "webOrigins": ["${PORTAL_PUBLIC_URL}"],
    "standardFlowEnabled": true,
    "attributes": {
      "post.logout.redirect.uris": "${PORTAL_PUBLIC_URL}/*"
    }
  }],
  "users": [{
    "username": "${MASTER_EMAIL}",
    "email": "${MASTER_EMAIL}",
    "enabled": true,
    "emailVerified": true,
    "credentials": [{
      "type": "password",
      "value": "${MASTER_PASSWORD}",
      "temporary": false
    }]
  }]
}
